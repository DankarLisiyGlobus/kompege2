  <property name="windowTitle">
   <string>Тестирующая программа КЕГЭ</string>
  </property>
  <property name="styleSheet">
   <string notr="true">QMainWindow{
	background-color: rgb(235, 235, 235);
}
/* Прозрачный фон самой области и её viewport */
QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea &gt; QWidget &gt; QWidget {
    background: transparent;
}

/* Вертикальный скроллбар */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
    border: none;
}

/* Дорожка (желоб) */
QScrollBar::handle:vertical {
    background: #c5cff5;          /* пастельный индиго под твою палитру */
    min-height: 30px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #a8b6ec;
}

QScrollBar::handle:vertical:pressed {
    background: #8a9ae0;
}

/* Убрать стрелки сверху/снизу */
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
    border: none;
}

/* Убрать «страничные» зоны (клик по желобу) */
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

/* Горизонтальный — на случай, если появится */
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
    border: none;
}

QScrollBar::handle:horizontal {
    background: #c5cff5;
    min-width: 30px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background: #a8b6ec;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    background: none;
    border: none;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}
</string>
  </property>
